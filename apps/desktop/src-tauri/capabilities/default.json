{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Zu Term windows: only what the UI calls (app commands, home dir, context menu, close, confirm dialog, text clipboard).",
  "windows": ["main", "zu-term-window-*"],
  "permissions": [
    "allow-config-read",
    "allow-config-write",
    "allow-workspace-lock-acquire",
    "allow-workspace-lock-release",
    "allow-workspace-lock-release-all",
    "allow-local-hostname",
    "allow-initial-cwd",
    "allow-pty-spawn",
    "allow-pty-write",
    "allow-pty-resize",
    "allow-pty-kill",
    "core:path:allow-resolve-directory",
    "core:menu:allow-new",
    "core:menu:allow-popup",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-message",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text"
  ]
}
