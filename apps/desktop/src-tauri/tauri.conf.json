{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zu Term",
  "version": "0.1.0",
  "identifier": "fyi.voza.zuterm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:17601",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "enableGTKAppId": false,
    "windows": [
      {
        "label": "main",
        "title": "Zu Term",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
